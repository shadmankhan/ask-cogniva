        <mxCell id="upload" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Upload organization PDFs&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;React admin dashboard&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Manage · replace · delete&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="An authenticated administrator uploads a PDF through the dashboard. Documents can be replaced, deleted, or retried after failed processing.">
          <mxGeometry x="70" y="240" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Authorize administrator&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;Hono + Better Auth&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Session + owner/admin role&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The server resolves the signed-in organization and requires owner or admin membership. File operations are scoped by that organization, not by a visitor-supplied organization ID.">
          <mxGeometry x="390" y="240" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Validate and reserve upload&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;Hono + pdf-lib&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;10 PDFs · 20 pages · 10 MB&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The server validates bytes, filename, PDF readability, file size, page count, and the organization quota. It reserves a processing record with the original PDF bytes before extraction.">
          <mxGeometry x="710" y="240" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="extract" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Extract each page&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;Local Firecrawl AnyDoc&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;PDF → page Markdown&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="pdf-lib separates pages and AnyDoc extracts Markdown locally. Text-based PDFs are supported; this application does not add an OCR stage.">
          <mxGeometry x="1030" y="240" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="chunk" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Chunk with page context&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;TypeScript&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;1,100 chars · 130 overlap&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The server splits page text into overlapping passages. Each chunk retains organization ID, document ID, and its original page number.">
          <mxGeometry x="1350" y="240" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="kb" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Organization knowledge base&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#0e7490;margin-top:7px&quot;&gt;SQLite + FTS5&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;PDFs · statuses · page passages&lt;br&gt;Atomic publish → ready&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e7490;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;shape=cylinder;boundedLbl=1;backgroundOutline=1;size=18;" vertex="1" parent="1" tooltip="One local SQLite database stores all organizations. The publish transaction adds passages, updates the search index through triggers, and marks the document ready. Replacing a ready PDF removes the old version only when the new version publishes successfully.">
          <mxGeometry x="1730" y="230" width="350" height="144" as="geometry" />
        </mxCell>
        <mxCell id="visitor" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Ask a question&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;React chat / iframe&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Organization-branded assistant&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The assistant reads its token from the URL fragment and sends it in the request body. Chat history is displayed locally; each backend question is evaluated independently.">
          <mxGeometry x="70" y="570" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="token" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Identify organization&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;Node.js / Hono&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Token lookup + rate limit&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The API hashes and validates the assistant token to resolve the organization, then rate-limits requests for that organization. Simple greetings, thanks, and identity questions are answered directly without retrieval or a model call.">
          <mxGeometry x="350" y="570" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="search" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Retrieve source pages&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#0e7490;margin-top:7px&quot;&gt;SQLite FTS5&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Org-filtered · ready PDFs only&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e7490;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="Keyword search uses English stemming, ranks matching chunks, and reconstructs up to six full pages. Both search and policy expansion use organization filters. No matches return no_answer; excessive source context returns unresolved.">
          <mxGeometry x="630" y="570" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Route the request&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#7c3aed;margin-top:7px&quot;&gt;LLM + TypeScript guards&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Information or decision&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The model classifies the question and selects actual evidence IDs. Application guards keep general and procedural requests factual and route clear personalized eligibility requests through policy checks. The planner does not decide eligibility.">
          <mxGeometry x="910" y="570" width="200" height="124" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Draft cited claims&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#7c3aed;margin-top:7px&quot;&gt;Configured LLM&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;One part per explicit request&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The composer drafts claims for each question part using retrieved pages. Every claim carries a page evidence ID and candidate source quote. Unsupported parts have no claims.">
          <mxGeometry x="1200" y="570" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Review drafted claims&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#7c3aed;margin-top:7px&quot;&gt;Separate LLM call&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Support · relevance · source&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="A second call checks each candidate claim for support, relevance to the question, and relevance of its quote. It can select a corrected contiguous excerpt from the same cited page. This is another model judgment, not a proof of correctness.">
          <mxGeometry x="1500" y="570" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="ground" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Validate source quotations&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;TypeScript&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Exact source · numbers · units&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="Code confirms the selected quote exists on the actual page and checks quantities with units and currencies. A numeric paraphrase falls back to the source wording only after semantic checks pass. Supported parts remain visible alongside gaps; inconclusive verification returns unresolved.">
          <mxGeometry x="1800" y="570" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Expand policy context&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#0e7490;margin-top:7px&quot;&gt;Org-scoped SQLite&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Full documents + named links&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e7490;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The server loads every page of selected policy documents and follows exact document-title cross-references within the same organization. Reading limits stop an oversized policy with unresolved instead of silently truncating it.">
          <mxGeometry x="630" y="875" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Build required-rule ledger&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;TypeScript&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Requirements before user facts&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="English requirement and prohibition heuristics build a fixed ledger before matching visitor facts. The planner cannot remove conditions. Recognized complex structures and oversized or empty ledgers return unresolved; this is not a general-purpose policy compiler.">
          <mxGeometry x="930" y="875" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="facts" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Match visitor facts to rules&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#7c3aed;margin-top:7px&quot;&gt;Configured LLM&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Exact quotes · all rule IDs&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The schema requires every ledger ID. The model copies exact contiguous visitor excerpts and preserves quantities and units. Missing facts stay missing. A bounded numeric correction can select only numbered excerpts from the real question.">
          <mxGeometry x="1230" y="875" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Check rule applicability&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#b45309;margin-top:7px&quot;&gt;Local Laya: System 1&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Choice + Boolean confirmation&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="Laya Choice classifies whether the source rule category applies. A Boolean applicability check corroborates exclusions. Excluded rules stay in the decision trace; uncertain applicability cannot approve a request. Laya calls are batched and serialized by the adapter.">
          <mxGeometry x="1530" y="875" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="semantic" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Evaluate semantic conditions&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#b45309;margin-top:7px&quot;&gt;Local Laya: Boolean / Noul&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Fact coverage · comply · violate&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="Boolean checks assess whether the fact addresses the rule, establishes compliance, or establishes an explicit violation. Lack of evidence is not a violation. Conflicting or inconclusive outcomes remain uncertain; scores are thresholds, not calibrated correctness probabilities.">
          <mxGeometry x="1530" y="1085" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="numeric" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Evaluate numeric conditions&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;TypeScript rule evaluator&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Boundaries · quantities · units&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="Code evaluates supported numeric thresholds, ranges, allowed values, and compatible units or scales. The visitor value must address the rule subject; unsafe interpretation stays uncertain. There are no hardcoded organization-specific policy cases.">
          <mxGeometry x="1830" y="1085" width="250" height="124" as="geometry" />
        </mxCell>
        <mxCell id="combine" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Combine results + explain&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#2563eb;margin-top:7px&quot;&gt;TypeScript verdict → LLM&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Failure wins · all must pass&lt;br&gt;Missing → ask · unsure → review&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="Code rejects when any applicable condition fails, asks for missing facts when no failure is established, and approves only when applicable checks exist and all pass. Otherwise it returns unresolved. The composer receives the computed verdict and checks; decision text retains verified policy excerpts, and code keeps the verdict authoritative.">
          <mxGeometry x="1830" y="1250" width="250" height="126" as="geometry" />
        </mxCell>
        <mxCell id="payload" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Return response JSON&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#047857;margin-top:7px&quot;&gt;Hono + shared contracts&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;status + text + references&lt;br&gt;Calculated checks when available&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#047857;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The API returns one of answered, needs_clarification, unresolved, no_answer, or acknowledged. Calculated decisions can include the verdict and check trace. Transport or provider failures remain errors; they are not disguised as successful answers.">
          <mxGeometry x="2165" y="990" width="330" height="146" as="geometry" />
        </mxCell>
        <mxCell id="render" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#14243b&quot;&gt;Display evidence and outcome&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:600;color:#047857;margin-top:7px&quot;&gt;React + json-render + Zod&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#526176;margin-top:9px&quot;&gt;Fixed cards · citations · trace&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#047857;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;" vertex="1" parent="1" tooltip="The client maps verified API data into a small read-only json-render catalog. Zod validates props and a direct fallback preserves the response if validation fails. Citation links reveal page excerpts without replacing the token fragment. The model does not generate UI layout.">
          <mxGeometry x="2165" y="1250" width="330" height="126" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="&lt;b&gt;Document lifecycle&lt;/b&gt;&lt;br&gt;&lt;br&gt;processing → ready or failed&lt;br&gt;Only ready PDFs are searched.&lt;br&gt;Failed uploads can be retried.&lt;br&gt;Failed replacements keep the original." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#66778d;" vertex="1" parent="1">
          <mxGeometry x="2130" y="225" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;b&gt;TENANT BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;One SQLite database; every document read&lt;br&gt;and write is scoped by organization ID.&lt;br&gt;Admin session ≠ public assistant token." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#66778d;" vertex="1" parent="1">
          <mxGeometry x="70" y="850" width="460" height="145" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;b&gt;ONE GENERATION PROVIDER&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ollama (local), Gemini, or OpenRouter&lt;br&gt;Planning · drafting · review · fact matching&lt;br&gt;Selected in .env; no automatic fallback." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#66778d;" vertex="1" parent="1">
          <mxGeometry x="70" y="1045" width="460" height="145" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;b&gt;SAFE EARLY RETURNS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Greeting / thanks / identity → direct reply&lt;br&gt;No retrieved pages → no_answer&lt;br&gt;Unsafe context / policy → unresolved" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=16;fontColor=#66778d;" vertex="1" parent="1">
          <mxGeometry x="70" y="1240" width="460" height="145" as="geometry" />
        </mxCell>
        <mxCell id="legend-0" value="&lt;b&gt;ANSWERED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Supported claims / computed verdict" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#047857;" vertex="1" parent="1">
          <mxGeometry x="70" y="1450" width="475" height="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" value="&lt;b&gt;CLARIFICATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Missing facts; no established failure" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="570" y="1450" width="475" height="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" value="&lt;b&gt;UNRESOLVED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Uncertain checks / unsupported policy" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="1070" y="1450" width="475" height="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-3" value="&lt;b&gt;NO ANSWER&lt;/b&gt;&lt;br&gt;&lt;br&gt;No supported source claims" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1450" width="475" height="85" as="geometry" />
        </mxCell>
        <mxCell id="legend-4" value="&lt;b&gt;ACKNOWLEDGED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Simple greeting / thanks / identity" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#2563eb;" vertex="1" parent="1">
          <mxGeometry x="2070" y="1450" width="475" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>