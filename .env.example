# Select openrouter or gemini and restart the server.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
LAYA_URL=http://127.0.0.1:8000
PORT=3001
COGNIVA_ORIGIN=http://localhost:5173
# COGNIVA_DB_PATH=data/cogniva.sqlite
# COGNIVA_SECRET=  # Optional. A local secret is generated under data/ by default.
